DATABASE_URL=postgresql+psycopg2://user:pwd@localhost:5432/database_name
SECRET_KEY=change-for-a-long-and-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (cache)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# Session life cycle on terminal
DEBUG_SESSION_LOG=false
